ndFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="495.0" as="sourcePoint"/><mxPoint x="600" y="495.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c26" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="495.0" as="sourcePoint"/><mxPoint x="230" y="495.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c27" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870.0" y="340" as="sourcePoint"/><mxPoint x="500.0" y="340" as="targetPoint"/><Array as="points"><mxPoint x="870.0" y="390"/><mxPoint x="500.0" y="390"/></Array></mxGeometry></mxCell><mxCell id="c28" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="748" as="sourcePoint"/><mxPoint x="400" y="748" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c29" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="748" as="sourcePoint"/><mxPoint x="770" y="748" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c30" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="748" as="sourcePoint"/><mxPoint x="1140" y="748" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c31" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="782" as="sourcePoint"/><mxPoint x="970" y="782" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c32" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="782" as="sourcePoint"/><mxPoint x="600" y="782" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c33" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="782" as="sourcePoint"/><mxPoint x="230" y="782" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c34" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=block;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="810" as="sourcePoint"/><mxPoint x="740" y="955" as="targetPoint"/><Array as="points"><mxPoint x="800" y="955"/></Array></mxGeometry></mxCell><mxCell id="c35" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=block;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="810" as="sourcePoint"/><mxPoint x="1140" y="955" as="targetPoint"/><Array as="points"><mxPoint x="940" y="955"/></Array></mxGeometry></mxCell><mxCell id="c36" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#333333;startArrow=none;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1103" as="sourcePoint"/><mxPoint x="830" y="1103" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;CareFlow: AI-Powered Hospital Operations and Resource Planning Platform&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="32" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Design D0: Data-Flow Diagram (Flow A: upload and forecast; Flow B: view or request a forecast)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="57" width="1400" height="25" as="geometry"/></mxCell><mxCell id="c39" value="Goal: help hospital administrators anticipate patient demand by forecasting admissions and bed occupancy for the next 7 days and flagging likely capacity and staffing shortages." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1400" height="24" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Flow A: data manager uploads a CSV (US-04). Timing budget: validation report in 30 s or less; forecasts and alerts refreshed within 2 minutes of upload.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1400" height="25" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;I4: CSV file&lt;/b&gt;&lt;br&gt;raw text" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="232.5" y="206" width="165" height="38" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;I2: file upload&lt;/b&gt;&lt;br&gt;multipart HTTPS" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="602.5" y="206" width="165" height="38" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;I5: file bytes&lt;/b&gt;&lt;br&gt;+ uploader ID" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="972.5" y="206" width="165" height="38" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;I6: validated records&lt;/b&gt;&lt;br&gt;typed daily rows" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1248.0" y="362" width="150" height="38" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;I8: history rows&lt;/b&gt;&lt;br&gt;last 365 days" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="972.5" y="550" width="165" height="38" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;I12: forecast run ID&lt;/b&gt;&lt;br&gt;forecast rows saved" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="602.5" y="550" width="165" height="38" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;I9: alert records&lt;/b&gt;&lt;br&gt;+ staffing estimates" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="232.5" y="550" width="165" height="38" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;I5 / I2: validation report&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="540.0" y="370" width="170" height="22" as="geometry"/></mxCell><mxCell id="c49" value="Forms of the data in Flow A: raw CSV text -&amp;gt; uploaded file -&amp;gt; validated, typed daily record -&amp;gt; stored history row -&amp;gt; 7-day forecast row (predicted admissions, predicted occupied beds) -&amp;gt; alert record and staffing estimate." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="587" width="1420" height="23" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Flow B: user views a forecast or requests a new one (UC-01, US-01 to US-03). Timing budget: stored results shown in 3 s or less; new forecast in 2 minutes or less.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="1420" height="25" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;I1: click / filter&lt;/b&gt;&lt;br&gt;dept or whole hospital" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="235" y="696" width="160" height="38" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;I2: HTTPS request&lt;/b&gt;&lt;br&gt;JSON params + token" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="605" y="696" width="160" height="38" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;I7: SQL query&lt;/b&gt;&lt;br&gt;dept, date range" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="975" y="696" width="160" height="38" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;I7: result rows&lt;/b&gt;&lt;br&gt;forecasts, flags" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="975" y="790" width="160" height="38" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;I2: JSON response&lt;/b&gt;&lt;br&gt;forecast + generated_at" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="603" y="790" width="165" height="38" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;I1: rendered view&lt;/b&gt;&lt;br&gt;charts + data tables" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="235" y="790" width="160" height="38" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;I3: token -&amp;gt; user, role&lt;/b&gt;" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="808" y="860" width="170" height="22" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;I11: request (dept or ALL)&lt;/b&gt;&lt;br&gt;-&amp;gt; run ID, status, or data error" style="text;html=1;align=center;fontSize=12;labelBackgroundColor=#ffffff;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="950" y="965" width="190" height="38" as="geometry"/></mxCell><mxCell id="c59" value="Forms of the data in Flow B: user action -&amp;gt; HTTPS JSON request with token -&amp;gt; SQL query (or forecast request) -&amp;gt; result rows -&amp;gt; JSON response -&amp;gt; chart plus an accessible data table." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1027" width="1420" height="23" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="300" height="25" as="geometry"/></mxCell><mxCell id="c61" value="External entity (person or system we do not build)." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="125" y="1095" width="560" height="23" as="geometry"/></mxCell><mxCell id="c62" value="Process: a component we build that transforms data." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="125" y="1133" width="560" height="23" as="geometry"/></mxCell><mxCell id="c63" value="Data store: C5 Operations Database (drawn more than once for readability; same database)." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="125" y="1171" width="560" height="23" as="geometry"/></mxCell><mxCell id="c64" value="Data crossing an interface: label = interface ID, the data, and its form." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="845" y="1095" width="600" height="23" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>