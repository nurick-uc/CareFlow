<mxfile host="app.diagrams.net"><diagram name="D0_Data_Flow" id="D0_Data_Flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1240"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;E1 Data Export&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;hospital CSV file&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;(external)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="200" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;C1 Web Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;file upload form&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;C2 Backend API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;check role, receive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;C4 Data Ingestion&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;validate rows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="200" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;C5 Operations DB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;store history&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="450" width="200" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;C6 Forecasting&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;train + predict 7 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="450" width="200" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;C7 Planning &amp;amp; Alerts&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;compare to settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;C5 Operations DB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;store forecasts, alerts&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="200" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Hospital Staff User&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;(external)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="200" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;C1 Web Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;render accessible views&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="720" width="200" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;C2 Backend API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;check token, query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="720" width="200" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;C5 Operations DB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;read&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="720" width="200" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;C3 Auth Module&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;verify token, role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="910" width="200" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;C6 Forecasting&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;on-demand run (UC-01)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="910" width="200" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1089" width="70" height="28" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1127" width="70" height="28" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;&lt;/b&gt;" style="shape=cylinder3;boundedLb