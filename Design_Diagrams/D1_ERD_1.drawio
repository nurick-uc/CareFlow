as="geometry"/></mxCell><mxCell id="e44" value="&lt;b&gt;0..*&lt;/b&gt;" style="text;html=1;fontSize=13;align=center;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="908.0" y="500.0" width="36" height="20" as="geometry"/></mxCell><mxCell id="e45" value="&lt;b&gt;F&lt;/b&gt;" style="ellipse;html=1;fillColor=#14284B;fontColor=#FFFFFF;strokeColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="979.0" y="514.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=none;html=1;strokeWidth=1.4;startArrow=ERmandOne;endArrow=ERzeroToMany;startSize=14;endSize=14;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="600" as="sourcePoint"/><mxPoint x="880" y="860.0" as="targetPoint"/><Array as="points"><mxPoint x="990" y="600"/><mxPoint x="990" y="860.0"/></Array></mxGeometry></mxCell><mxCell id="e47" value="&lt;b&gt;1&lt;/b&gt;" style="text;html=1;fontSize=13;align=center;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1036.0" y="605.0" width="36" height="20" as="geometry"/></mxCell><mxCell id="e48" value="&lt;b&gt;0..*&lt;/b&gt;" style="text;html=1;fontSize=13;align=center;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="908.0" y="835.0" width="36" height="20" as="geometry"/></mxCell><mxCell id="e49" value="&lt;b&gt;H&lt;/b&gt;" style="ellipse;html=1;fillColor=#14284B;fontColor=#FFFFFF;strokeColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="979.0" y="719.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="e50" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;color:#B03A2E&#x27;&gt;PK&lt;/b&gt; = Primary Key&amp;nbsp;&amp;nbsp; &lt;b style=&#x27;color:#1F618D&#x27;&gt;FK&lt;/b&gt; = Foreign Key&amp;nbsp;&amp;nbsp; &lt;u&gt;&lt;b&gt;Underlined attribute&lt;/b&gt;&lt;/u&gt; = Primary Key&lt;br&gt;1 = Exactly one (two bars)&amp;nbsp;&amp;nbsp; 0..1 = Zero or one (circle + bar)&amp;nbsp;&amp;nbsp; 0..* = Zero or many (circle + crow&#x27;s foot)&lt;br&gt;&lt;b&gt;INT&lt;/b&gt; = Integer; &lt;b&gt;UUID&lt;/b&gt; = Universally Unique Identifier; &lt;b&gt;VARCHAR&lt;/b&gt; = Variable-length text; &lt;b&gt;DECIMAL&lt;/b&gt; = Numeric decimal value; &lt;b&gt;DATE&lt;/b&gt; = Calendar date; &lt;b&gt;TIMESTAMP&lt;/b&gt; = Date and time; &lt;b&gt;BOOLEAN&lt;/b&gt; = True/false value; &lt;b&gt;TEXT&lt;/b&gt; = Long text&lt;br&gt;Letters A–H name the 8 relationships." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FAFBFD;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="700" height="230" as="geometry"/></mxCell><mxCell id="e51" value="&lt;b&gt;Database Design Constraints&lt;/b&gt;&lt;br&gt;• DailyObservation: UNIQUE(department_id, observation_date)&lt;br&gt;• ForecastValue: UNIQUE(run_id, department_id, target_date)&lt;br&gt;• PlanningSetting: UNIQUE(department_id)&lt;br&gt;• All foreign keys reference their corresponding primary keys.&lt;br&gt;• DailyObservation.import_batch_id is an ordinary attribute, not a foreign key in this model." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFBEA;strokeColor=#C9A227;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="1030" width="700" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>